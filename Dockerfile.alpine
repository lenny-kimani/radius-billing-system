FROM php:8.2-fpm-alpine

# Set working directory
WORKDIR /var/www/html

# Install system dependencies
RUN apk add --no-cache \
    nginx \
    supervisor \
    dcron \
    bash \
    curl \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    freetype-dev \
    libjpeg-turbo-dev \
    oniguruma-dev \
    libxml2-dev

# Install PHP extensions
RUN docker-php-ext-install pdo_mysql gd zip mbstring xml curl

# Create run directories
RUN mkdir -p /run/nginx /var/log/supervisor /var/run/php

# Copy configuration files
COPY conf/fpm-pool.conf /usr/local/etc/php-fpm.d/www.conf
COPY conf/php.ini /usr/local/etc/php/conf.d/custom.ini
COPY conf/nginx.conf /etc/nginx/nginx.conf

# Setup sessions
RUN mkdir -p /var/lib/php/sessions && chown www-data:www-data /var/lib/php/sessions

# Copy application source
COPY --chown=www-data:www-data ./src /var/www/html
RUN chmod -R 775 /var/www/html

# Setup Crontab
ADD conf/crontab /etc/crontabs/root

# Supervisor config
COPY conf/supervisord.conf /etc/supervisord.conf

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
