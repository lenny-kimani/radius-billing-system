FROM php:8.2-fpm-alpine

# Set working directory
WORKDIR /var/www/html

# Install system dependencies
RUN apk add --no-cache \
    nginx \
    supervisor \
    dcron \
    bash \
    curl \
    curl-dev \
    libpng-dev \
    libzip-dev \
    zip \
    unzip \
    freetype-dev \
    libjpeg-turbo-dev \
    oniguruma-dev \
    libxml2-dev \
    libwebp-dev \
    icu-dev

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_mysql gd zip mbstring xml curl intl bcmath

# Create run directories and set permissions
RUN mkdir -p /run/nginx /var/log/supervisor /run/php /var/lib/php/sessions \
    && chown -R www-data:www-data /run/php /var/lib/php/sessions /var/log/nginx /var/lib/nginx /run/nginx

# Copy configuration files
COPY conf/fpm-pool.conf /usr/local/etc/php-fpm.d/www.conf
COPY conf/php.ini /usr/local/etc/php/conf.d/custom.ini
COPY conf/nginx.conf /etc/nginx/nginx.conf

# Copy application source
COPY --chown=www-data:www-data ./src /var/www/html

# Ensure writable directories exist and have correct permissions
RUN mkdir -p system/uploads system/cache system/plugin system/paymentgateway ui/cache ui/compiled \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html \
    && find /var/www/html -type d -exec chmod 775 {} + \
    && find /var/www/html -type f -exec chmod 664 {} +

# Setup Crontab
COPY conf/crontab-alpine /etc/crontabs/root

# Supervisor config
COPY conf/supervisord-alpine.conf /etc/supervisord.conf

# Volumes for persistence
VOLUME ["/var/www/html/system/uploads", "/var/www/html/system/cache", "/var/www/html/ui/cache", "/var/www/html/ui/compiled"]

# Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost/fpm-ping || exit 1

EXPOSE 80

CMD ["/bin/bash", "-c", "php /var/www/html/docker-init.php && chown -R www-data:www-data /var/www/html && /usr/bin/supervisord -c /etc/supervisord.conf"]
